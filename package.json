{
  "name": "teem-golf-api",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/generators"
  ],
  "scripts": {
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "synth": "nx run-many -t synth",
    "generate:app": "nx g @teem-labs/generators:app"
  },
  "devDependencies": {
    "@nx/devkit": "^23.0.0",
    "@nx/eslint": "^23.0.0",
    "@nx/eslint-plugin": "^23.0.0",
    "@teem-labs/generators": "workspace:*",
    "eslint": "^9.36.0",
    "nx": "^23.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
