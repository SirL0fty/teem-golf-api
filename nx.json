{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "plugins": ["nx/plugins/package-json"],
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": true
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "synth": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/cdk.out"]
    },
    "deploy": {
      "dependsOn": ["^build"]
    },
    "diff": {
      "dependsOn": ["^build"]
    }
  }
}
