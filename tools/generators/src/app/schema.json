{
  "$schema": "https://json-schema.org/schema",
  "$id": "app",
  "title": "CDK app",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "App folder name. Lowercase words separated by single hyphens.",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    }
  },
  "required": ["name"]
}
