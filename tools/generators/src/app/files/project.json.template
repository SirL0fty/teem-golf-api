{
  "name": "<%= name %>",
  "root": "apps/<%= name %>",
  "sourceRoot": "apps/<%= name %>/src",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:app", "scope:<%= name %>"],
  "targets": {
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/<%= name %>"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit -p tsconfig.json",
      "options": {
        "cwd": "apps/<%= name %>"
      }
    },
    "test": {
      "command": "bun test",
      "options": {
        "cwd": "apps/<%= name %>"
      }
    },
    "build": {
      "command": "tsc --noEmit -p tsconfig.json",
      "options": {
        "cwd": "apps/<%= name %>"
      }
    },
    "synth": {
      "command": "bun run synth",
      "options": {
        "cwd": "apps/<%= name %>"
      }
    },
    "deploy": {
      "command": "bun run deploy",
      "options": {
        "cwd": "apps/<%= name %>"
      }
    }
  }
}
