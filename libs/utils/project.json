{
  "name": "utils",
  "root": "libs/utils",
  "sourceRoot": "libs/utils/src",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["type:package", "scope:shared"],
  "targets": {
    "build": {
      "command": "tsc -p tsconfig.json",
      "options": {
        "cwd": "libs/utils"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
      "options": {
        "cwd": "libs/utils"
      }
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "libs/utils"
      }
    },
    "test": {
      "command": "bun test",
      "options": {
        "cwd": "libs/utils"
      }
    }
  }
}
